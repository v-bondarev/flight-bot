# Скопировать в .env рядом (/opt/flight-bot/.env) и заполнить. В git .env не коммитим.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Путь к базе подписок (SQLite)
DB_PATH=/opt/flight-bot/flight-bot.sqlite

# Период опроса рейсов, сек
POLL_INTERVAL_SEC=300

# Сколько держать подписку после прилёта перед снятием, сек
GRACE_SEC=3600

# Ключ scrape.do — для табло с антиботом/JS (DME, Pulkovo). Для SVO не нужен.
SCRAPEDO_API_KEY=

# Ключ API Яндекс.Расписаний — реестр «номер рейса → аэропорт» вне Москвы.
YANDEX_RASP_API_KEY=
