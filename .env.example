# Скопировать в .env рядом (/opt/flight-bot/.env) и заполнить. В git .env не коммитим.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Telegram user id через запятую — чьи команды и кнопки бот принимает В ГРУППАХ (узнать: @userinfobot).
# Личка открыта всем. Пусто — в группах тоже всем.
OWNER_IDS=

# Обращение на «вы» в приветствии /start: username=Имя Отчество через запятую. Только здесь, не в коде.
GREET_NAMES=

# Путь к базе подписок (SQLite)
DB_PATH=/opt/flight-bot/flight-bot.sqlite
# Куда зеркалить ежедневные копии базы rsync'ом (user@host:путь/, ключ ssh без пароля). Пусто — только локально.
BACKUP_RSYNC_TARGET=

# Период опроса рейсов, сек
POLL_INTERVAL_SEC=300

# Ключ scrape.do — для табло с антиботом/JS (DME, Pulkovo). Для SVO не нужен.
SCRAPEDO_API_KEY=

# Ключ AirLabs (airlabs.co) — статус и маршрут рейса по номеру вне наших табло.
AIRLABS_API_KEY=
# Дата истечения ключа AirLabs (ГГГГ-ММ-ДД, МСК): за 7 дней до неё и после — напоминание владельцам раз в день.
# Пусто — без напоминания.
AIRLABS_KEY_EXPIRES=

# Ключ AeroDataBox (RapidAPI, X-RapidAPI-Key) — даты рейса на 5 дней вперёд при поиске.
# Пусто — даты только с табло (вчера/сегодня/завтра). Запрос = 6 единиц из 400 бесплатных в месяц.
AERODATABOX_API_KEY=
# Платных запросов расписания за скользящие 31 день (66 = 400/6 — весь бесплатный тариф). Сверх — даты только с табло.
AERODATABOX_BUDGET=60

# Выход для AeroDataBox: RapidAPI отвечает 451 адресу сервера бота. SOCKS туннеля до DK-хоста,
# см. deploy/dk-proxy.service. Пусто — напрямую.
SCHEDULE_PROXY_URL=socks5://127.0.0.1:1081

# Свой RU-выход для табло, которые не пускают зарубежный адрес (dme.ru): SOCKS SSH-туннеля до RU-хоста.
# Пусто — при блоке сразу scrape.do. См. deploy/ru-proxy.service.
RU_PROXY_URL=socks5://127.0.0.1:1080

# Одновременных запросов к scrape.do (кредиты платные, подписки опрашиваются параллельно)
SCRAPEDO_CONCURRENCY=2

# Резервный рендер для VKO при ошибке HTTP API/челленджа, через туннель -L.
# Без него VKO работает через HTTP; при ошибке — следующий источник (AirLabs).
RENDER_URL=http://127.0.0.1:8765

# Кэш VKO HTTP-поиска и резервного HTML-рендера, сек
RENDER_CACHE_SEC=75
