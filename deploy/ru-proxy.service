# SSH-туннель с сервера бота до хоста с российским адресом, SOCKS на
# localhost: свой RU-выход для табло, которые не пускают зарубежный адрес
# (dme.ru). На RU-хосте ничего не ставится — прокси делает сам sshd.
# Требования: autossh на сервере бота, ключ пользователя сервиса в
# authorized_keys на RU-хосте, Host ru-host в ~/.ssh/config пользователя.
#   sudo apt install autossh
#   sudo cp /opt/flight-bot/deploy/ru-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ru-proxy
#   curl -x socks5h://127.0.0.1:1080 -sS -o /dev/null -w '%{http_code}\n' https://www.dme.ru/
[Unit]
Description=ru-proxy — SOCKS через RU-хост для flight-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vbondarev
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes \
  -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
  -D 127.0.0.1:1080 ru-host
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
